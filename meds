    const blankText = $("blank-text");
    const samples = $("samples");
    const statusLine = $("status");
    const resetButton = $("reset");
    const groupsList = $("groups-list");
    const legendOverlay = $("legend-overlay");
    const legendToggle = $("legend-toggle");
    const toast = $("toast");
    const statHits = $("stat-hits");
    const statNames = $("stat-names");
    const statSubs = $("stat-subs");
    const statAtc = $("stat-atc");
    const statScope = $("stat-scope");

    const state = {
      query: "",
      sub: true,
      atc: true,
      rollup: false,
      strict: false,
      groups: new Set()
    };

    let rows = [];
    let active = -1;
    let timer;

    /* ---------- normalizálás ---------- */

    const COMBINING = /[\u0300-\u036f]/g;

    function norm(value) {
      return value.normalize("NFD").replace(COMBINING, "").toLocaleLowerCase("hu");
    }

    /* Karakterenkénti normalizálás, hogy a kiemelés az eredeti szövegben is a helyére kerüljön. */
    function normMap(value) {
      let out = "";
      const map = [];
      for (let i = 0; i < value.length; i += 1) {
        const piece = norm(value[i]);
        for (let j = 0; j < piece.length; j += 1) map.push(i);
        out += piece;
      }
      return { text: out, map };
    }

    const index = DATA.map((record) => ({
      row: record,
      name: norm(record[0]),
      atc: norm(record[1]),
      sub: norm(record[2]),
      group: record[1] ? record[1][0].toUpperCase() : ""
    }));

    const groupCounts = new Map();
    for (const item of index) {
      if (!item.group) continue;
      groupCounts.set(item.group, (groupCounts.get(item.group) || 0) + 1);
    }

    const numberFormat = new Intl.NumberFormat("hu-HU");
    const fmt = (value) => numberFormat.format(value);

    /* ---------- főcsoportok az oldalsávban ---------- */

    for (const [letter, name] of ATC_GROUPS) {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "group";
      button.dataset.group = letter;
      button.setAttribute("aria-pressed", "false");
      button.innerHTML = '<span class="letter"></span><span class="name"></span><span class="n"></span>';
      button.children[0].textContent = letter;
      button.children[1].textContent = name;
      button.children[2].textContent = fmt(groupCounts.get(letter) || 0);
      groupsList.append(button);
    }

    /* ---------- szűrés ---------- */

    function collect() {
      const query = state.query;
      const groups = state.groups;
      const buckets = [[], [], [], [], [], []];

      for (const item of index) {
        if (groups.size && !groups.has(item.group)) continue;
        if (state.strict && (!item.row[1] || !item.row[2])) continue;

        if (!query) {
          buckets[5].push(item.row);
          continue;
        }

        if (item.name === query) buckets[0].push(item.row);
        else if (item.name.startsWith(query)) buckets[1].push(item.row);
        else if (state.atc && item.atc.startsWith(query)) buckets[2].push(item.row);
        else if (item.name.includes(query)) buckets[3].push(item.row);
        else if (state.sub && item.sub.includes(query)) buckets[4].push(item.row);
        else if (state.atc && item.atc.includes(query)) buckets[5].push(item.row);
      }

      return buckets[0].concat(buckets[1], buckets[2], buckets[3], buckets[4], buckets[5]);
    }

    function rollUp(list) {
      const map = new Map();
      for (const row of list) {
        const key = row[0] + "\u0000" + row[1] + "\u0000" + row[2];
        const found = map.get(key);
        if (found) found.packs += 1;
        else map.set(key, { row, packs: 1 });
      }
      return [...map.values()].map((entry) =>
        entry.packs > 1
          ? [entry.row[0], entry.row[1], entry.row[2], entry.packs + " kiszerelés", true]
          : entry.row
      );
    }

    /* ---------- számláló kártyák ---------- */

    function updateStats(list, scope) {
      const names = new Set();
      const subs = new Set();
      const codes = new Set();
      for (const row of list) {
        names.add(row[0]);
        if (row[2]) subs.add(row[2]);
        if (row[1]) codes.add(row[1]);
      }
      statHits.textContent = fmt(list.length);
      statNames.textContent = fmt(names.size);
      statSubs.textContent = fmt(subs.size);
      statAtc.textContent = fmt(codes.size);
      statScope.textContent = scope;
    }

    /* ---------- megjelenítés ---------- */

    function fill(target, value, missingLabel) {
      if (!value) {
        const none = document.createElement("span");
        none.className = "none";
        none.textContent = missingLabel;
        target.append(none);
        return;
      }

      const query = state.query;
      if (!query) {
        target.textContent = value;
        return;
      }

      const { text, map } = normMap(value);
      const at = text.indexOf(query);
      if (at < 0) {
        target.textContent = value;
        return;
      }

      const from = map[at];
      const to = map[at + query.length - 1] + 1;
      const mark = document.createElement("mark");
      mark.textContent = value.slice(from, to);
      target.append(value.slice(0, from), mark, value.slice(to));
    }

    function addCell(row, value, label, className, missingLabel, pill) {
      const cell = document.createElement("td");
      cell.className = className;
      cell.dataset.label = label;
      if (pill && value) {
        const span = document.createElement("span");
        span.className = "code";
        fill(span, value, missingLabel);
        cell.append(span);
      } else {
        fill(cell, value, missingLabel);
      }
      row.append(cell);
    }

    function showBlank(title, text, withSamples) {
      resultsBody.replaceChildren();
      sheetScroll.hidden = true;
      blank.hidden = false;
      blankTitle.textContent = title;
      blankText.textContent = text;
      samples.hidden = !withSamples;
      active = -1;
    }

    function scopeLabel(raw) {
      const parts = [];
      if (raw) parts.push("„" + raw + "”");
      if (state.groups.size) parts.push([...state.groups].sort().join(" "));
      return parts.length ? parts.join(" · ") : "teljes törzs";
    }

    function render() {
      const raw = searchInput.value.trim();
      state.query = norm(raw);
      clearButton.classList.toggle("on", raw.length > 0);

      const hasFilter = state.groups.size > 0 || state.rollup || state.strict;
      resetButton.hidden = !hasFilter && !raw;

      if (!state.query && !state.groups.size) {
        statusLine.textContent = "írjon be egy nevet";
        updateStats(DATA, "teljes törzs");
        showBlank(
          "Mire keres?",
          "Kezdje el gépelni a készítmény nevét, vagy válasszon egy ATC-főcsoportot a bal oldalon.",
          true
        );
        return;
      }

      const matches = collect();
      updateStats(matches, scopeLabel(raw));
      rows = state.rollup ? rollUp(matches) : matches;

      if (rows.length === 0) {
        statusLine.textContent = "0 találat";
        showBlank(
          "Nincs találat",
          raw
            ? `A(z) „${raw}” kifejezésre nincs találat. Próbáljon rövidebb keresést, vagy oldja fel a szűrőket.`
            : "A kiválasztott főcsoportokban nincs a szűrőknek megfelelő sor."
        );
        return;
      }

      const shown = Math.min(rows.length, MAX_VISIBLE);
      const fragment = document.createDocumentFragment();

      for (let i = 0; i < shown; i += 1) {
        const record = rows[i];
        const tr = document.createElement("tr");
        tr.dataset.i = String(i);
        addCell(tr, record[1], "ATC", "atc", "nincs adat", true);
        addCell(tr, record[0], "Készítmény", "name", "nincs adat", false);
        addCell(tr, record[3], "Kiszerelés", record[4] ? "pack rollup" : "pack", "nincs adat", false);
        addCell(tr, record[2], "Hatóanyag", "sub", "nincs adat", false);
        fragment.append(tr);
      }

      resultsBody.replaceChildren(fragment);
      blank.hidden = true;
      sheetScroll.hidden = false;

      statusLine.textContent =
        rows.length > MAX_VISIBLE
          ? `${fmt(rows.length)} találat · első ${fmt(shown)} látszik`
          : `${fmt(rows.length)} találat`;

      setActive(0, false);
    }

    function schedule() {
      window.clearTimeout(timer);
      timer = window.setTimeout(render, 80);
    }

    /* ---------- kijelölés és másolás ---------- */

    function setActive(nextIndex, scroll = true) {
      const items = resultsBody.children;
      if (!items.length) { active = -1; return; }
      const bounded = Math.max(0, Math.min(nextIndex, items.length - 1));
      if (active >= 0 && items[active]) items[active].classList.remove("active");
      active = bounded;
      const target = items[active];
      target.classList.add("active");
      if (scroll) target.scrollIntoView({ block: "nearest" });
    }

    function flash(message) {
      toast.textContent = message;
      toast.classList.add("on");
      window.clearTimeout(flash.timer);
      flash.timer = window.setTimeout(() => toast.classList.remove("on"), 1500);
    }

    function fallbackCopy(text, label) {
      const helper = document.createElement("textarea");
      helper.value = text;
      helper.setAttribute("readonly", "");
      helper.style.cssText = "position:fixed;top:0;left:-9999px";
      document.body.append(helper);
      helper.select();
      let ok = false;
      try { ok = document.execCommand("copy"); } catch (error) { ok = false; }
      helper.remove();
      flash(ok ? (label || text) + " — másolva" : "a másolás nem sikerült");
    }

    function copy(text, label) {
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(
          () => flash((label || text) + " — másolva"),
          () => fallbackCopy(text, label)
        );
        return;
      }
      fallbackCopy(text, label);
    }

    function copyActive() {
      if (active < 0 || !rows[active]) return;
      const record = rows[active];
      copy(record[1] || record[0]);
    }

    /* A teljes sor tabulátorral tagolva megy a vágólapra, az oszlopsorrend szerint. */
    function copyActiveRow() {
      if (active < 0 || !rows[active]) return;
      const record = rows[active];
      const line = [record[1], record[0], record[3], record[2]]
        .map((value) => (value || "").replace(/\s+/g, " ").trim())
        .join("\t");
      copy(line, "a teljes sor");
    }

    /* ---------- események ---------- */

    searchInput.addEventListener("input", schedule);

    clearButton.addEventListener("click", () => {
      searchInput.value = "";
      render();
      searchInput.focus();
    });

    resetButton.addEventListener("click", () => {
      searchInput.value = "";
      state.groups.clear();
      state.rollup = false;
      state.strict = false;
      syncChips();
      render();
      searchInput.focus();
    });

    samples.addEventListener("click", (event) => {
      const button = event.target.closest("[data-query]");
      if (!button) return;
      searchInput.value = button.dataset.query;
      render();
      searchInput.focus();
    });

    resultsBody.addEventListener("click", (event) => {
      const tr = event.target.closest("tr[data-i]");
      if (tr) setActive(Number(tr.dataset.i), false);
    });

    resultsBody.addEventListener("dblclick", (event) => {
      const tr = event.target.closest("tr[data-i]");
      if (!tr) return;
      setActive(Number(tr.dataset.i), false);
      copyActiveRow();
    });

    groupsList.addEventListener("click", (event) => {
      const button = event.target.closest("[data-group]");
      if (!button) return;
      const letter = button.dataset.group;
      if (state.groups.has(letter)) state.groups.delete(letter);
      else state.groups.add(letter);
      syncChips();
      render();
    });

    function bindToggle(id, key) {
      const chip = $(id);
      chip.addEventListener("click", () => {
        state[key] = !state[key];
        chip.setAttribute("aria-pressed", String(state[key]));
        render();
      });
    }

    bindToggle("chip-sub", "sub");
    bindToggle("chip-atc", "atc");
    bindToggle("chip-rollup", "rollup");
    bindToggle("chip-strict", "strict");

    function syncChips() {
      $("chip-sub").setAttribute("aria-pressed", String(state.sub));
      $("chip-atc").setAttribute("aria-pressed", String(state.atc));
      $("chip-rollup").setAttribute("aria-pressed", String(state.rollup));
      $("chip-strict").setAttribute("aria-pressed", String(state.strict));
      for (const button of groupsList.children) {
        button.setAttribute("aria-pressed", String(state.groups.has(button.dataset.group)));
      }
    }

    /* ---------- jelmagyarázat ---------- */

    function openLegend(open) {
      legendOverlay.hidden = !open;
      if (open) $("legend-close").focus();
      else legendToggle.focus();
    }

    legendToggle.addEventListener("click", () => openLegend(true));
    $("legend-close").addEventListener("click", () => openLegend(false));
    legendOverlay.addEventListener("click", (event) => {
      if (event.target === legendOverlay) openLegend(false);
    });

    /* ---------- billentyűzet ---------- */

    document.addEventListener("keydown", (event) => {
      const typing = event.target === searchInput;

      if (!legendOverlay.hidden) {
        if (event.key === "Escape") { event.preventDefault(); openLegend(false); }
        return;
      }

      if (event.key === "/" && !typing && !event.metaKey && !event.ctrlKey) {
        event.preventDefault();
        searchInput.focus();
        searchInput.select();
        return;
      }

      if (event.key === "Escape") {
        if (searchInput.value) {
          searchInput.value = "";
          render();
          searchInput.focus();
        }
        return;
      }

      if (event.key === "ArrowDown" || event.key === "ArrowUp") {
        if (!resultsBody.children.length) return;
        event.preventDefault();
        setActive(active + (event.key === "ArrowDown" ? 1 : -1));
        return;
      }

      if (event.key === "Enter" && resultsBody.children.length) {
        event.preventDefault();
        if (event.shiftKey) copyActiveRow();
        else copyActive();
      }
    });

    syncChips();
    render();
  </script>
</body>
</html>
