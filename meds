    const MAX_VISIBLE = 250;

    const ATC_GROUPS = [
      ["A", "Emésztőrendszer, anyagcsere"],
      ["B", "Vér és vérképző szervek"],
      ["C", "Szív és érrendszer"],
      ["D", "Bőrgyógyászat"],
