      ["S", "Érzékszervek"],
      ["V", "Egyéb (varia)"]
    ];

    const $ = (id) => document.getElementById(id);
    const searchInput = $("search");
    const clearButton = $("clear");
    const resultsBody = $("results");
    const sheetScroll = $("sheet-scroll");
    const blank = $("blank");
