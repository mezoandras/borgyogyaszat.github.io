<!doctype html>
<html lang="hu">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#1a1a1a">
  <title>Gyógyszerkereső</title>
  <style>
    :root {
      color-scheme: light;
      --bg: #e3ee9e;
      --frame: #1a1a1a;
      --stage: #ececea;
      --card: #ffffff;
      --ink: #171717;
      --dim: #8a8e8b;
      --soft: #b9bcb8;
      --line: #ececeb;
      --lime: #dcef4f;
      --lime-dim: #eaf5a2;
      --violet: #b3a4f2;
      --violet-soft: #e2ddfc;
      --radius: 22px;
      --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
    }

    * { box-sizing: border-box; }

    html { min-width: 320px; }

    body {
      margin: 0;
      padding: 0;
      background: var(--frame);
      color: var(--ink);
      font-family: "Avenir Next", "Segoe UI Variable Display", "Segoe UI", system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif;
      font-size: 14px;
      line-height: 1.45;
      -webkit-font-smoothing: antialiased;
    }

    button, input { font: inherit; color: inherit; }
    :focus-visible { outline: 3px solid var(--violet); outline-offset: 2px; }

    /* ---------- keret ---------- */

    .app {
      display: grid;
      grid-template-columns: 244px minmax(0, 1fr);
      gap: 14px;
      width: 100%;
      height: 100vh;
      height: 100dvh;
      overflow: hidden;
      padding: 14px;
      background: var(--frame);
    }

    /* ---------- oldalsáv ---------- */

    .rail {
      display: flex;
      flex-direction: column;
      gap: 14px;
      min-width: 0;
      min-height: 0;
      height: 100%;
      padding: 12px 10px 4px;
      overflow: hidden;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 0 6px;
      color: #fff;
      font-size: 19px;
      font-weight: 800;
      letter-spacing: -0.03em;
    }

    .brand-mark {
      display: grid;
      width: 30px;
      height: 30px;
      place-items: center;
      border-radius: 10px;
      background: var(--lime);
      color: var(--frame);
    }

    .brand-mark svg { width: 17px; height: 17px; }

    .rail-label {
      margin: 0;
      padding: 0 8px;
      color: #6d6f6c;
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .groups {
      flex: 1 1 auto;
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-height: 72px;
      overflow-y: auto;
      overscroll-behavior: contain;
      padding-right: 4px;
    }

    .groups::-webkit-scrollbar { width: 5px; }
    .groups::-webkit-scrollbar-thumb { border-radius: 3px; background: #3a3a3a; }

    .group {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      padding: 8px 12px;
      border: 0;
      border-radius: 999px;
      background: transparent;
      color: #b6b8b4;
      font-size: 13px;
      text-align: left;
      cursor: pointer;
      transition: background 120ms ease, color 120ms ease;
    }

    .group:hover { background: #262626; color: #fff; }

    .group[aria-pressed="true"] {
      background: #fff;
      color: var(--frame);
      font-weight: 700;
    }

    .group .letter {
      flex: none;
      display: grid;
      width: 24px;
      height: 24px;
      place-items: center;
      border-radius: 8px;
      background: #2b2b2b;
      color: var(--lime);
      font-family: var(--mono);
      font-size: 12px;
      font-weight: 700;
    }

    .group[aria-pressed="true"] .letter { background: var(--frame); color: var(--lime); }

    .group .name {
      flex: 1;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .group .n {
      flex: none;
      padding: 1px 7px;
      border-radius: 999px;
      background: #2b2b2b;
      color: #9a9d98;
      font-family: var(--mono);
      font-size: 10.5px;
    }

    .group[aria-pressed="true"] .n { background: var(--lime); color: var(--frame); }

    .promo {
      flex: none;
      padding: 15px 16px 14px;
      border-radius: 20px;
      background: var(--lime);
      color: var(--frame);
    }

    .promo h2 {
      margin: 0 0 3px;
      font-size: 17px;
      font-weight: 800;
      letter-spacing: -0.025em;
    }

    .promo p { margin: 0 0 12px; font-size: 11.5px; opacity: 0.72; }

    .keys { display: grid; gap: 6px; margin-bottom: 13px; }

    .keys div { display: flex; align-items: center; gap: 7px; font-size: 11.5px; }

    kbd {
      display: inline-grid;
      min-width: 22px;
      height: 21px;
      padding: 0 5px;
      place-items: center;
      border-radius: 6px;
      background: rgba(26, 26, 26, 0.12);
      font-family: var(--mono);
      font-size: 11px;
      font-weight: 700;
    }

    .promo-btn {
      width: 100%;
      padding: 10px;
      border: 0;
      border-radius: 999px;
      background: var(--frame);
      color: #fff;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
    }

    .promo-btn:hover { background: #2e2e2e; }

    /* ---------- színpad ---------- */

    .stage {
      display: flex;
      flex-direction: column;
      min-width: 0;
      min-height: 0;
      padding: 22px 22px 18px;
      border-radius: 26px;
      background: var(--stage);
      overflow: hidden;
    }

    .topline {
      flex: none;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 20px;
      flex-wrap: wrap;
      margin-bottom: 18px;
    }

    h1 {
      margin: 0;
      font-size: clamp(34px, 4.4vw, 52px);
      font-weight: 800;
      letter-spacing: -0.035em;
      line-height: 1.02;
    }

    .subline { margin: 6px 0 0; color: #7d817e; font-size: 13px; }

    .stamp {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 16px;
      border-radius: 999px;
      background: var(--card);
      color: #6f736f;
      font-family: var(--mono);
      font-size: 11.5px;
      white-space: nowrap;
    }

    .stamp b { color: var(--ink); }

    /* ---------- kereső ---------- */

    .searchbar {
      flex: none;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 8px 8px 8px 20px;
      border-radius: 999px;
      background: var(--card);
    }

    .searchbar:focus-within { box-shadow: 0 0 0 3px var(--violet-soft); }

    .searchbar > svg { flex: none; width: 20px; height: 20px; color: var(--soft); }

    #search {
      flex: 1;
      min-width: 0;
      height: 44px;
      padding: 0;
      border: 0;
      outline: none;
      background: transparent;
      font-size: 17px;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    #search::placeholder { color: var(--soft); font-weight: 500; letter-spacing: 0; }
    #search::-webkit-search-cancel-button { display: none; }

    .clear {
      flex: none;
      display: none;
      width: 44px;
      height: 44px;
      padding: 0;
      place-items: center;
      border: 0;
      border-radius: 50%;
      background: var(--frame);
      color: #fff;
      cursor: pointer;
    }

    .clear svg { width: 16px; height: 16px; }
    .clear.on { display: grid; }

    .chiprow {
      flex: none;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 14px 0 16px;
    }

    .chip {
      padding: 8px 15px;
      border: 0;
      border-radius: 999px;
      background: var(--card);
      color: #6f736f;
      font-size: 12.5px;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      transition: background 120ms ease, color 120ms ease;
    }

    .chip:hover { color: var(--ink); }

    .chip[aria-pressed="true"] { background: var(--frame); color: #fff; }

    .chip.reset { background: transparent; color: #6f736f; text-decoration: underline; text-underline-offset: 3px; }
    .chip.reset:hover { color: var(--ink); }

    /* ---------- statisztika ---------- */

    .stats {
      flex: none;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      gap: 12px;
      margin-bottom: 12px;
    }

    .stat {
      padding: 16px 18px 15px;
      border-radius: 20px;
      background: var(--card);
    }

    .stat.dark { background: var(--frame); color: #fff; }

    .stat-top {
      display: flex;
      align-items: center;
      gap: 9px;
      margin-bottom: 12px;
      font-size: 13px;
      font-weight: 700;
    }

    .stat-icon {
      flex: none;
      display: grid;
      width: 28px;
      height: 28px;
      place-items: center;
      border-radius: 9px;
      background: var(--stage);
    }

    .stat-icon svg { width: 15px; height: 15px; }
    .stat.dark .stat-icon { background: #2b2b2b; }
    .stat.violet .stat-icon { background: var(--violet-soft); }
    .stat.lime .stat-icon { background: var(--lime-dim); }

    .stat-value {
      display: flex;
      align-items: baseline;
      gap: 7px;
      font-size: 32px;
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 1;
    }

    .stat-value span { color: var(--dim); font-size: 12px; font-weight: 600; letter-spacing: 0; }
    .stat.dark .stat-value span { color: #8e918c; }

    .badge {
      margin-left: auto;
      padding: 3px 9px;
      border-radius: 999px;
      background: var(--lime);
      color: var(--frame);
      font-size: 11px;
      font-weight: 700;
      white-space: nowrap;
    }

    /* ---------- találatok ---------- */

    .sheet {
      flex: 1 1 auto;
      display: flex;
      flex-direction: column;
      min-height: 180px;
      padding: 6px 6px 6px;
      border-radius: var(--radius);
      background: var(--card);
      overflow: hidden;
    }

    .sheet-top {
      flex: none;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 6px 16px;
      padding: 12px 14px 10px;
    }

    .sheet-top h2 { margin: 0; font-size: 15px; font-weight: 800; letter-spacing: -0.02em; }

    #status { color: var(--dim); font-family: var(--mono); font-size: 11.5px; }

    table { width: 100%; border-collapse: separate; border-spacing: 0; table-layout: fixed; }

    thead th {
      position: sticky;
      top: 0;
      z-index: 5;
      padding: 9px 14px;
      background: var(--card);
      color: var(--soft);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-align: left;
      text-transform: uppercase;
      white-space: nowrap;
    }

    col.c-atc { width: 13%; }
    col.c-name { width: 32%; }
    col.c-pack { width: 26%; }
    col.c-sub { width: 29%; }

    tbody td {
      padding: 11px 14px;
      border-top: 1px solid var(--line);
      font-size: 13.5px;
      line-height: 1.4;
      vertical-align: top;
      overflow-wrap: anywhere;
    }

    tbody tr:hover td { background: #fafaf8; }

    tbody tr.active td { background: var(--violet-soft); }
    tbody tr.active td:first-child { border-radius: 12px 0 0 12px; }
    tbody tr.active td:last-child { border-radius: 0 12px 12px 0; }

    td.name { font-weight: 700; letter-spacing: -0.01em; }
    td.sub { color: #63676a; }
    td.pack { color: #63676a; font-family: var(--mono); font-size: 11.5px; }
    td.rollup { color: #7a7e80; font-family: inherit; font-size: 12.5px; font-style: italic; }

    .code {
      display: inline-block;
      padding: 3px 9px;
      border-radius: 999px;
      background: var(--violet-soft);
      color: #3c3363;
      font-family: var(--mono);
      font-size: 11.5px;
      font-weight: 700;
    }

    mark { padding: 1px 2px; border-radius: 4px; background: var(--lime); color: inherit; }

    .none { color: #bcc0bd; }

    .scroller {
      flex: 1 1 auto;
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .scroller::-webkit-scrollbar, .groups::-webkit-scrollbar { width: 8px; }
    .scroller::-webkit-scrollbar-thumb { border-radius: 4px; background: #dcdcd9; }
    .scroller::-webkit-scrollbar-thumb:hover { background: #c6c6c2; }

    /* ---------- üres állapot ---------- */

    .blank { padding: 48px 20px 54px; text-align: center; }

    .blank-icon {
      display: grid;
      width: 64px;
      height: 64px;
      margin: 0 auto 16px;
      place-items: center;
      border-radius: 22px;
      background: var(--lime);
      color: var(--frame);
    }

    .blank-icon svg { width: 28px; height: 28px; }

    .blank h3 { margin: 0 0 6px; font-size: 20px; font-weight: 800; letter-spacing: -0.03em; }

    .blank p { max-width: 430px; margin: 0 auto; color: #7d817e; font-size: 13.5px; }

    .samples { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 18px; }

    .sample {
      padding: 8px 15px;
      border: 0;
      border-radius: 999px;
      background: var(--stage);
      font-size: 12.5px;
      font-weight: 700;
      cursor: pointer;
    }

    .sample:hover { background: var(--lime); }

    footer {
      flex: none;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 4px 16px;
      margin-top: 14px;
      padding: 0 6px;
      color: #8b8f8c;
      font-size: 11px;
    }

    /* ---------- réteg ---------- */

    .overlay {
      position: fixed;
      inset: 0;
      z-index: 80;
      display: grid;
      padding: 20px;
      place-items: center;
      background: rgba(23, 23, 23, 0.45);
    }

    .modal {
      width: min(560px, 100%);
      max-height: 84vh;
      overflow-y: auto;
      padding: 22px 24px 24px;
      border-radius: 24px;
      background: var(--frame);
      color: #d7d9d5;
    }

    .modal-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 16px;
    }

    .modal-top h2 { margin: 0; color: #fff; font-size: 20px; font-weight: 800; letter-spacing: -0.03em; }

    .modal-close {
      padding: 8px 16px;
      border: 0;
      border-radius: 999px;
      background: #2b2b2b;
      color: #fff;
      font-size: 12.5px;
      font-weight: 700;
      cursor: pointer;
    }

    .modal-close:hover { background: var(--lime); color: var(--frame); }

    .modal dl { display: grid; gap: 13px; margin: 0; font-size: 13px; }

    .modal dt { margin-bottom: 2px; color: var(--lime); font-weight: 700; }
    .modal dd { margin: 0; color: #a4a7a2; line-height: 1.5; }
    .modal code { color: var(--violet); font-family: var(--mono); font-size: 12px; }

    .toast {
      position: fixed;
      bottom: 26px;
      left: 50%;
      z-index: 90;
      padding: 11px 20px;
      border-radius: 999px;
      background: var(--frame);
      color: var(--lime);
      font-size: 13px;
      font-weight: 700;
      opacity: 0;
      pointer-events: none;
      transform: translate(-50%, 8px);
      transition: opacity 140ms ease, transform 140ms ease;
    }

    .toast.on { opacity: 1; transform: translate(-50%, 0); }

    [hidden] { display: none !important; }

    /* ---------- reszponzív ---------- */

    @media (max-width: 1080px) {
      .app { grid-template-columns: 1fr; gap: 12px; padding: 12px; height: auto; min-height: 100vh; overflow: visible; }
      .rail { gap: 12px; height: auto; padding: 8px 4px 0; overflow: visible; }
      .stage { overflow: visible; }
      .sheet { overflow: visible; }
      .scroller { overflow: visible; }
      .groups {
        flex-direction: row;
        overflow-x: auto;
        overflow-y: hidden;
        gap: 6px;
        padding-bottom: 4px;
      }
      .groups { flex: none; min-height: 0; padding-right: 0; }
      .group { width: auto; flex: none; }
      .group .n { display: none; }
      .promo { display: none; }
      .stage { padding: 18px 16px 20px; }
    }

    @media (max-width: 720px) {
      .app { padding: 8px; }
      .searchbar { padding-left: 16px; }
      #search { height: 40px; font-size: 15.5px; }
      .stats { grid-template-columns: 1fr 1fr; }
      .stat { padding: 13px 14px; }
      .stat-value { font-size: 25px; }
      table, thead, tbody, tr, td { display: block; }
      colgroup { display: none; }
      thead { display: none; }
      tbody tr { padding: 10px 12px; border-top: 1px solid var(--line); border-radius: 14px; }
      tbody tr:first-child { border-top: 0; }
      tbody tr.active { background: var(--violet-soft); }
      tbody tr.active td, tbody tr:hover td { background: transparent; }
      tbody td {
        display: grid;
        grid-template-columns: 78px minmax(0, 1fr);
        gap: 8px;
        padding: 3px 0;
        border: 0;
      }
      tbody td::before {
        content: attr(data-label);
        color: var(--soft);
        font-size: 9.5px;
        font-weight: 800;
        letter-spacing: 0.08em;
        line-height: 1.9;
        text-transform: uppercase;
      }
      tbody tr.active td:first-child, tbody tr.active td:last-child { border-radius: 0; }
    }

    @media (max-width: 430px) {
      .stats { grid-template-columns: 1fr; }
      footer { display: block; }
      footer span { display: block; margin-top: 4px; }
    }

    @media (prefers-reduced-motion: reduce) {
      * { transition: none !important; }
    }
  </style>
</head>
<body>
  <div class="app">
    <aside class="rail">
      <div class="brand">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
            <path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z" />
            <path d="m8.5 8.5 7 7" />
          </svg>
        </span>
        <span>törzs</span>
      </div>

      <p class="rail-label">ATC-főcsoportok</p>
      <nav class="groups" id="groups-list" aria-label="ATC-főcsoportok"></nav>

      <div class="promo">
        <h2>Gyorsbillentyűk</h2>
        <p>Egérhasználat nélkül is megy.</p>
        <div class="keys">
          <div><kbd>/</kbd> keresés</div>
          <div><kbd>↑</kbd><kbd>↓</kbd> lépés a listában</div>
          <div><kbd>⏎</kbd> ATC-kód másolása</div>
          <div><kbd>⇧</kbd><kbd>⏎</kbd> teljes sor</div>
          <div><kbd>esc</kbd> törlés</div>
        </div>
        <button class="promo-btn" id="legend-toggle" type="button">Jelmagyarázat</button>
      </div>
    </aside>

    <main class="stage">
      <div class="topline">
        <div>
          <h1>Gyógyszerkereső</h1>
          <p class="subline">Keressen név, hatóanyag vagy ATC-kód alapján.</p>
        </div>
        <span class="stamp"><b>tk_lista.csv</b> · 41 327 kiszerelés</span>
      </div>

      <div class="searchbar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-4-4" />
        </svg>
        <input id="search" type="search" placeholder="Kezdje el gépelni…" autocomplete="off" spellcheck="false" autofocus aria-describedby="status">
        <button class="clear" id="clear" type="button" aria-label="Keresés törlése">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true">
            <path d="m6 6 12 12M18 6 6 18" />
          </svg>
        </button>
      </div>

      <div class="chiprow">
        <button class="chip" id="chip-sub" type="button" aria-pressed="true">hatóanyagra is</button>
        <button class="chip" id="chip-atc" type="button" aria-pressed="true">ATC-kódra is</button>
        <button class="chip" id="chip-rollup" type="button" aria-pressed="false">kiszerelések összevonva</button>
        <button class="chip" id="chip-strict" type="button" aria-pressed="false">hiányos sorok nélkül</button>
        <button class="chip reset" id="reset" type="button" hidden>szűrők törlése</button>
      </div>

      <section class="stats" aria-label="Összesítés">
        <div class="stat lime">
          <div class="stat-top">
            <span class="stat-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" />
              </svg>
            </span>
            Találat
            <span class="badge" id="stat-scope">teljes törzs</span>
          </div>
          <div class="stat-value"><strong id="stat-hits">0</strong><span>sor</span></div>
        </div>

        <div class="stat violet">
          <div class="stat-top">
            <span class="stat-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z" />
                <path d="m8.5 8.5 7 7" />
              </svg>
            </span>
            Készítmény
          </div>
          <div class="stat-value"><strong id="stat-names">0</strong><span>egyedi név</span></div>
        </div>

        <div class="stat">
